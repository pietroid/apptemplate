# Copy to .env.local for development (the setup CLI writes it for you). On
# the Pi the same keys live in /opt/apptemplate/.env, next to
# docker-compose.yml.
#
# Load order: .env.{NODE_ENV}.local -> .env.{NODE_ENV} -> .env.local -> .env

PORT=3000

# Postgres on Neon: the `dev` branch locally, `main` in production. Keep
# sslmode=require. Offline? `npm run db:local` and point this at
# postgresql://postgres@localhost:5433/postgres?sslmode=disable
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth.
# The public origin the app is served from. Dev: the server itself.
# Production: https://apptemplate.pietroteruya.dev
BETTER_AUTH_URL=http://localhost:3000
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Extra origins a browser may call from: the Flutter web dev server.
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth clients, comma separated, the web client first: it does the
# web redirect flow and owns GOOGLE_CLIENT_SECRET. Then every iOS and
# Android client whose ID tokens the server accepts.
GOOGLE_CLIENT_IDS=WEB_CLIENT_ID.apps.googleusercontent.com,IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Who may sign up, comma separated. Empty lets any Google account in.
ALLOWED_EMAILS=

# The assistant, through OpenRouter. Leave the key empty and the assistant
# answers 503; everything else works without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: models OpenRouter falls back to when that one errs, comma-separated.
OPENROUTER_FALLBACK_MODELS=
# Optional: how hard the model thinks (low by default).
OPENROUTER_REASONING=low

# PostHog (US cloud). The project key is public by design; leave it empty
# and the server sends nothing (dev, tests, CI).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
